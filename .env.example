# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# PORT: Server port (defaults to 3000)
PORT=3000

# Optional 3rd Party AI Providers (Can also be configured via Settings UI)
OPENAI_API_KEY=""
ANTHROPIC_API_KEY=""
CUSTOM_OPENAI_BASE_URL=""
CUSTOM_OPENAI_API_KEY=""

# ElevenLabs Voice API
ELEVENLABS_API_KEY=""
ELEVENLABS_DEFAULT_VOICE_ID=""

# Web Search Provider (Optional Serper / Tavily key or native Gemini grounding)
SERPER_API_KEY=""
TAVILY_API_KEY=""

# Firebase Configuration (Optional if integrating Firebase Auth/Firestore)
FIREBASE_PROJECT_ID=""
FIREBASE_CLIENT_EMAIL=""
FIREBASE_PRIVATE_KEY=""

# Storage / Sandbox
SANDBOX_TIMEOUT_MS="5000"

